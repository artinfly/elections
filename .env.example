# Образец настроек. Скопируйте в .env и заполните своими значениями.
# Сам .env в git не попадает.

# --- Django ---
# Секретный ключ: длинная случайная строка, своя на каждой машине.
# Получить: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Адреса, по которым открывается сайт, через запятую
ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных PostgreSQL ---
DB_NAME=elections_test
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Внешние сервисы (пустой адрес — функция выключена) ---
# Кадровый сервис для ФИО в админке, например http://hr.local/api/employee/
HR_SERVICE_API_URL=

# --- Фронтенд на другом адресе (API /api/…) ---
# Адреса фронтенда через запятую, например http://localhost:7001.
# Пусто — CORS выключен. Нужна библиотека django-cors-headers.
CORS_ALLOWED_ORIGINS=

# --- Только для рабочего сервера ---
# Настройки сервера вместо настроек разработки (manage.py по умолчанию берёт dev)
# DJANGO_SETTINGS_MODULE=config.settings.prod
# True, если сайт открывается по https://
# HTTPS=False
# Сайт за nginx: адрес и протокол из заголовков прокси; адреса для проверки форм
# USE_X_FORWARDED_HOST=True
# SECURE_PROXY_SSL_HEADER=True
# CSRF_TRUSTED_ORIGINS=https://elections.local
# Несколько сервисов на одном имени сервера: у каждого свои cookie
# SESSION_COOKIE_NAME=elections_sessionid
# CSRF_COOKIE_NAME=elections_csrftoken
