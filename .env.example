# Скопируйте этот файл в .env и заполните значения. .env в git не попадает.

# --- Django ---
# DEBUG=True только на рабочем месте разработчика; на сервере — False.
DEBUG=True
SECRET_KEY=change-me-to-a-random-string-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных ---
DB_NAME=elections
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# --- Кадровый API (админка) ---
# Например: http://hr.local/api/employee/
HR_SERVICE_API_URL=
